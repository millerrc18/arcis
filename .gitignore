# Training artifacts
# Match files inside the dir (not the dir itself) so allowlisted
# files like train.py + README.md can be re-included via `!`. Git
# does not allow re-including child paths under an excluded
# directory pattern (the `training_data/` form), per gitignore rules.
training_data/*
!training_data/README.md
!training_data/train.py
*.pkl
*.gguf
*.safetensors
unsloth_compiled_cache/

# Model outputs
models/

# Cache
.cache/
*.pickle

# Claude Code
.claude/*
!.claude/plugins

# Misc
*.log
*.bak
*.tmp
.env

# Frontend build
frontend/dist/
frontend/node_modules/
node_modules/

# Capacitor iOS build artifacts
ios/App/Pods/
ios/App/DerivedData/
ios/App/build/
-e 
# Secrets

PLAN_REVIEW.md
scripts/fix_quarantine.py
scripts/merge_lora_cpu.py
scripts/patch_gguf_bos.py
scripts/smoke_test_arcis.py
scripts/smoke_test_raw.py
scripts/test_adapter_direct.py
scripts/test_gguf_direct.py
scripts/test_merged_hf.py

# Pipeline scratchpad (session-local)
.tmp/

# Operator's local scratch/debug files at repo root
# (the leading-underscore pattern anchors to root only — does NOT
# affect legitimate private modules like src/api/.../_command_ttl.py)
/_*.py
/_*.sql

# Coding-team plugin dashboard + PR-body artifacts
.arcis/

# Sprint #111 — periodic-discipline runtime state (.gitkeep preserved)
data/periodic-discipline/.lock
data/periodic-discipline/reports/*.json

# Phase 5 IMPL Campaign — coordinator session state (operator-local)
.coordinator-state.json
.coordinator-state.json.tmp
.HALT_CAMPAIGN
