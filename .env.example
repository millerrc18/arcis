# Halcyon Lab environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# --- Alpaca (paper trading) ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Anthropic (LLM) ---
ANTHROPIC_API_KEY=

# --- Render cloud database ---
DATABASE_URL=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Finnhub (market data) ---
FINNHUB_API_KEY=

# --- Dashboard auth (cloud mode) ---
HALCYON_API_SECRET=
HALCYON_CLOUD_MODE=false
