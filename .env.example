# Arcis — Environment Secrets
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit actual secrets.
# settings.yaml handles ALL non-secret configuration and IS committed.

# === Alpaca (Paper Trading) ===
ALPACA_API_KEY=your-paper-api-key
ALPACA_API_SECRET=your-paper-api-secret

# === Alpaca (Live Trading) ===
ALPACA_LIVE_API_KEY=your-live-api-key
ALPACA_LIVE_SECRET_KEY=your-live-secret-key

# === Claude / Anthropic (Council sessions) ===
ANTHROPIC_API_KEY=your-anthropic-api-key

# === Data Sources ===
FINNHUB_API_KEY=your-finnhub-api-key
FRED_API_KEY=your-fred-api-key

# === Telegram Notifications ===
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# === Email (optional, for alerts) ===
EMAIL_PASSWORD=your-app-password

# === Cloud Dashboard (Render) ===
API_SECRET=your-dashboard-api-secret

# === Local API Auth (optional, opt-in) ===
# Enables API_SECRET enforcement on the local FastAPI server.
# Leave unset for open local access. pytest is hermetic to this var (PR #729).
# ARCIS_LOCAL_API_TOKEN=your-local-api-token

# Database
# Required: runtime fails without this. Set to your local SQLite path.
ARCIS_DB_PATH=C:\arcis-data\ai_research_desk.sqlite3
# DATABASE_URL=postgresql://user:pass@host:5432/dbname  # Cloud only (Render)

# Alpaca
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Override: live or paper
# ALPACA_PAPER_TRADE=true  # Set to false for live trading

# Grafana Cloud Loki (centralized log aggregation)
# GRAFANA_LOKI_TOKEN=glc_...
