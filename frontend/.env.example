# Arcis Frontend Environment Variables
#
# API URL — leave blank for local dev (proxied via vite.config.js)
VITE_API_URL=

# Cloud mode flag — set to "true" when deploying to Render/cloud
VITE_IS_CLOUD=false

# Dashboard access token — this is a LOW-SECURITY dashboard-only access
# token, NOT a real API secret. It is intentionally bundled into the
# frontend JS because the dashboard is a single-user admin tool.
# The token gates casual access; it does not protect sensitive data.
# For production, set API_SECRET on the backend and use the same value here.
VITE_API_SECRET=
